# Local development settings. Copy to backend/.env (never commit .env).
PORT=5000

# Long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_SETUP_KEY=

# Frontend URLs allowed to call the API (comma-separated), or *
ALLOWED_ORIGINS=*

AWS_REGION=us-east-1
USERS_TABLE=campusconnect-users
JOBS_TABLE=campusconnect-jobs

# DynamoDB Local (npm run db:local, then npm run db:setup).
# Remove this line to use the real tables in your AWS account.
DYNAMODB_ENDPOINT=http://localhost:8000

# DynamoDB Local accepts any credentials. For real AWS, paste the
# temporary keys from Learner Lab's "AWS Details" instead, plus AWS_SESSION_TOKEN.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Resume uploads need a real S3 bucket: use the ResumeBucketName output
# from `sam deploy` and real AWS credentials above.
RESUME_BUCKET=

# Only for scripts/migrate-from-atlas.js
MONGO_URI=
