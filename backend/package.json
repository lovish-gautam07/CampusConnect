{
  "name": "campusconnect-backend",
  "version": "1.0.0",
  "description": "CampusConnect placement portal API (AWS Lambda + DynamoDB + S3)",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "db:local": "docker run --rm -p 8000:8000 amazon/dynamodb-local",
    "db:setup": "node scripts/create-local-tables.js",
    "copy-from-atlas": "node scripts/migrate-from-atlas.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "app.js",
    "lambda.js",
    "server.js",
    "config/",
    "controllers/",
    "middleware/",
    "models/",
    "routes/",
    "storage/"
  ],
  "keywords": [],
  "author": "Harsh",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/lib-dynamodb": "^3.1173.0",
    "@aws-sdk/s3-presigned-post": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0",
    "mongodb": "^7.9.1",
    "nodemon": "^3.1.14"
  }
}
